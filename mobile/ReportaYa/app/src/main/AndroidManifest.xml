<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ReportaYaApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_reporta_logo"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_reporta_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReportaYa">

        <activity android:name=".ui.PendingOperationsActivity" android:exported="false" />
        <activity android:name=".ui.HomeActivity" android:exported="false" />
        <activity android:name=".ui.IncidentEditActivity" android:exported="false" />
        <activity android:name=".ui.IncidentDetailActivity" android:exported="false" />
        <activity android:name=".ui.RegisterIncidentActivity" android:exported="false" />
        <activity android:name=".ui.IncidentListActivity" android:exported="false" />
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
